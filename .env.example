# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=campus_parking

# Full connection string used by Prisma (backend only)
DATABASE_URL=postgresql://parking_user:your_db_password@localhost:5432/campus_parking
# ─── Backend Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Backend Server ───────────────────────────────────────────────────────────
PORT=4000
# Allowed CORS origin — add mobile app origin here later
CLIENT_URL=http://localhost:5173

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
# Leave blank to disable email in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@ksu-parking.local

# ─── Evidence Storage (Cloudinary) ───────────────────────────────────────────
# Leave blank to use local /uploads fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Simulator ────────────────────────────────────────────────────────────────
# Set to false to disable occupancy simulation in production
SIMULATOR_ENABLED=true

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
